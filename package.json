{
  "name": "finora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Finora — xodimlarni boshqarish tizimi",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node --watch backend/server.js",
    "dev:all": "concurrently -k -n frontend,backend \"npm:dev\" \"npm:dev:backend\"",
