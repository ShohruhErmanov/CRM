# Server port
PORT=4000

# SQLite database file (relative paths are resolved from the project root)
DB_PATH=backend/database/finora.db

# Allowed frontend origin(s), comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Uploaded employee photos directory
UPLOAD_DIR=backend/uploads

# Maximum photo size in bytes (2 MB)
MAX_PHOTO_SIZE=2097152

# Insert example departments and positions on first run (true/false)
SEED_REFERENCE_DATA=true
